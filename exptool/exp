#!/usr/bin/env bash
# exp - one entry point for training runs: register, inspect, start, stop, resume.
#
# Every command prints the command it actually runs first (the grey + ...), so you
# can copy it, modify it, and use it directly. Once you're comfortable you don't
# need this tool at all.
#
# Config: read from ~/.config/exptool/config by default; override with EXPT_CONF.
# If you haven't configured it, copy exptool.conf.example and edit that.
#
# Only two external dependencies by design: ssh (when the machine column isn't
# local) and tmux (for start/stop). The read-only commands don't need tmux.

set -uo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

# ---- defaults; the config file overrides these ----------------------------
RUNS_CONF="$SELF_DIR/runs.conf"
REWARD_HEALTH_URL=""
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5"
REMOTE_PYTHON="python3"
FAILED_MARKER="FAILED"
DONE_MARKER="DONE"
LOG_DIR="logs"
PLAN_FILE="PLAN.md"
# The exp report renderer runs locally, so use it. Empty means fall back to
# REMOTE_PYTHON (in local mode the two are the same thing anyway).
LOCAL_PYTHON=""
# Where exp report writes by default (relative to the current directory). Keep it
# out of the run directory - that may be shared, read-only, or someone else's.
# Override for a single call with exp report --out <path>.
REPORT_DIR="."
# ---------------------------------------------------------------------------

EXPT_CONF="${EXPT_CONF:-$HOME/.config/exptool/config}"
if [ -f "$EXPT_CONF" ]; then
  # shellcheck disable=SC1090
  . "$EXPT_CONF"
fi

show_cmd() {
  # Goes to stderr: stdout is reserved for data, or the echo would pollute $(...)
  if [ -t 2 ]; then
    printf '\033[90m+ %s\033[0m\n' "$*" >&2
  else
    printf '+ %s\n' "$*" >&2
  fi
}

run_on() {
  # run_on <machine|local> <command>
  local machine="$1"; shift
  local cmd="$*"
  if [ "$machine" = "local" ]; then
    show_cmd "$cmd"
    sh -c "$cmd"
  else
    show_cmd "ssh $machine $cmd"
    # shellcheck disable=SC2086
    ssh $SSH_OPTS "$machine" "$cmd"
  fi
}

# Table: tab separated, handed to column for alignment.
fmt_table() {
  if command -v column >/dev/null 2>&1; then
    column -t -s "$(printf '\t')"
  else
    cat
  fi
}

plan_field() {
  # Pull a "field: value" line out of stdin. Accepts both the full-width and the
  # ASCII colon; a leading - or * is allowed.
  #
  # The colon has to be written \(:\|：\), not folded into a bracket expression:
  # sed matches brackets byte by byte, and the full-width colon is 3 bytes, so
  # putting it in [] would eat only its first byte and leave mojibake before the
  # value. $1 may be an alternation, and it must arrive already grouped as
  # '\(Criterion\|判据\)' - \| binds loosest, so an ungrouped 'Criterion\|判据'
  # would turn the whole regex into "starts with Criterion" OR "contains 判据:".
  sed -n "s/^[[:space:]]*[-*]*[[:space:]]*$1[[:space:]]*\(:\|：\)[[:space:]]*//p" | head -n 1
}

runs_lines() {
  if [ ! -f "$RUNS_CONF" ]; then
    echo "runs registry not found: $RUNS_CONF" >&2
    echo "copy the template first: cp $SELF_DIR/runs.conf.example $RUNS_CONF" >&2
    return 1
  fi
  grep -vE '^[[:space:]]*(#|$)' "$RUNS_CONF"
}

find_run() {
  local want="$1" line name
  while IFS= read -r line; do
    name="${line%%[[:space:]]*}"
    if [ "$name" = "$want" ]; then
      echo "$line"
      return 0
    fi
  done < <(runs_lines)
  echo "no run named $want is registered. Run exp list to see what is." >&2
  return 1
}

first_run_name() {
  runs_lines | head -n 1 | awk '{print $1}'
}

resolve_dir() {
  # Relative paths resolve against the registry's own directory, so
  # ./examples/demo-sft works from anywhere.
  local dir="$1"
  case "$dir" in
    ./*) dir="${dir#./}" ;;
  esac
  case "$dir" in
    /*|~*) echo "$dir" ;;
    *) echo "$(dirname "$RUNS_CONF")/$dir" ;;
  esac
}

# Parse one registry line into R_NAME / R_MACHINE / R_DIR / R_METHOD / R_TMUX / R_NOTE
load_run() {
  local name="$1" line
  line="$(find_run "$name")" || return 1
  read -r R_NAME R_MACHINE R_DIR R_METHOD R_TMUX R_NOTE <<< "$line"
  R_DIR="$(resolve_dir "$R_DIR")"
  return 0
}

newest_log() {
  run_on "$1" "find '$2/$LOG_DIR' -type f -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-" 2>/dev/null
}

cmd_list() {
  if [ ! -f "$RUNS_CONF" ]; then
    runs_lines >/dev/null || return 1
  fi

  # Ask tmux once per machine rather than ssh-ing for every row
  local tmux_dump="" machine session
  while IFS= read -r machine; do
    [ -n "$machine" ] || continue
    while IFS= read -r session; do
      [ -n "$session" ] && tmux_dump="${tmux_dump}${machine} ${session}
"
    done <<< "$(run_on "$machine" "tmux list-sessions -F '#{session_name}' 2>/dev/null" 2>/dev/null || true)"
  done <<< "$(runs_lines | awk '{print $2}' | sort -u)"

  local line name dir method tmuxname note state
  {
    printf 'name\tmachine\tmethod\ttmux\tdir\n'
    while IFS= read -r line; do
      read -r name machine dir method tmuxname note <<< "$line"
      if [ "$tmuxname" = "-" ]; then
        state="-"
      elif printf '%s' "$tmux_dump" | grep -qx "$machine $tmuxname"; then
        state="up"
      else
        state="down"
      fi
      printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$machine" "$method" "$state" "$dir"
    done < <(runs_lines)
  } | fmt_table
}

cmd_gpu() {
  local machine="${1:-}"
  if [ -z "$machine" ]; then
    echo "usage: exp gpu <machine>" >&2
    return 1
  fi
  run_on "$machine" "nvidia-smi --query-gpu=index,memory.used,memory.total,utilization.gpu --format=csv,noheader,nounits" \
    | awk -F', *' '
      NF >= 4 {
        free = $3 - $2
        printf "  GPU %-3s %6s / %6s MiB used   util %3s%%   %s\n", $1, $2, $3, $4, (free > $3 * 0.9 ? "<- free" : "")
      }
      NF < 4 { print "  " $0 }'
}

health_lines() {
  # One line per health check. status and report share this logic.
  #   $1 = text  plain text for a human (used by status)
  #   $1 = tsv   "status<TAB>label<TAB>value" (used by report), status: ok / warn / info
  local fmt="${1:-text}"
  _health() {
    if [ "$fmt" = "tsv" ]; then
      printf '%s\t%s\t%s\n' "$1" "$2" "$3"
    else
      printf '  %s: %s\n' "$2" "$3"
    fi
  }

  # is the tmux session still there
  if [ "$R_TMUX" = "-" ]; then
    _health info "tmux" "- (this run isn't managed by exp start/stop)"
  elif run_on "$R_MACHINE" "tmux has-session -t '$R_TMUX' 2>/dev/null" >/dev/null 2>&1; then
    _health ok "tmux $R_TMUX" "up"
  else
    _health warn "tmux $R_TMUX" "gone -> run exp errors $R_NAME to see the failure"
  fi

  # marker files
  local marks
  marks="$(run_on "$R_MACHINE" "for f in '$FAILED_MARKER' '$DONE_MARKER'; do [ -e \"$R_DIR/\$f\" ] && echo \"\$f\"; done" 2>/dev/null || true)"
  if [ -z "$marks" ]; then
    _health info "marker files" "none"
  else
    _health warn "marker files" "$(echo "$marks" | tr '\n' ' ')"
  fi

  # when the log last changed
  local newest mtime now mins
  newest="$(newest_log "$R_MACHINE" "$R_DIR")"
  if [ -z "$newest" ]; then
    _health warn "log" "not found (look in $R_DIR/$LOG_DIR)"
  else
    mtime="$(run_on "$R_MACHINE" "stat -c %Y '$newest' 2>/dev/null || stat -f %m '$newest' 2>/dev/null" 2>/dev/null || true)"
    now="$(run_on "$R_MACHINE" "date +%s" 2>/dev/null || true)"
    if [ -n "$mtime" ] && [ -n "$now" ]; then
      mins=$(( (now - mtime) / 60 ))
      if [ "$mins" -gt 30 ]; then
        _health warn "log last updated" "${mins} min ago ($(basename "$newest"))"
        if [ "$fmt" = "tsv" ]; then
          printf 'warn\tlog stalled\tno update for over 30 min; may be stuck on the reward service, NCCL, or a deadlock\n'
        else
          printf '    -> no update for over 30 min; may be stuck on the reward service, NCCL, or a deadlock\n'
        fi
      else
        _health ok "log last updated" "${mins} min ago ($(basename "$newest"))"
      fi
    else
      _health info "log" "$(basename "$newest") (could not read mtime)"
    fi
  fi

  # reward service (only checked when configured)
  if [ -n "$REWARD_HEALTH_URL" ]; then
    local code
    code="$(run_on "$R_MACHINE" "curl -s -o /dev/null -m 5 -w '%{http_code}' '$REWARD_HEALTH_URL'" 2>/dev/null || true)"
    case "$code" in
      200|401) _health ok "reward service" "up (HTTP $code)" ;;
      000|"")  _health warn "reward service" "no response (HTTP ${code:-000}) -> the service may be down" ;;
      *)       _health info "reward service" "HTTP $code" ;;
    esac
  fi
}

cmd_status() {
  local name="${1:-$(first_run_name)}"
  load_run "$name" || return 1

  printf 'run: %s\n' "$R_NAME"
  printf 'machine: %s\n' "$R_MACHINE"
  printf 'dir: %s\n' "$R_DIR"
  printf 'method: %s\n' "$R_METHOD"
  echo
  echo "health checks"
  health_lines text

  # Pre-registration: put the criterion next to the metrics, so you're forced to
  # check against the standard you set before the run instead of hunting for a
  # reason afterwards. Not writing one isn't blocked, just flagged.
  echo
  echo "pre-registration"
  local plan crit pred
  plan="$(run_on "$R_MACHINE" "cat '$R_DIR/$PLAN_FILE'" 2>/dev/null || true)"
  if [ -z "$plan" ]; then
    echo "  no $PLAN_FILE yet. Write the six items before you run -> exp plan $R_NAME"
  else
    crit="$(printf '%s\n' "$plan" | plan_field '\(Criterion\|判据\)')"
    pred="$(printf '%s\n' "$plan" | plan_field '\(Prediction\|预测\)')"
    if [ -n "$crit" ]; then
      echo "  criterion: $crit"
    else
      echo "  criterion: (not written) - the item most often skipped, and the one that matters most"
    fi
    if [ -n "$pred" ]; then
      echo "  prediction: $pred"
    fi
    echo "  (full text: exp plan $R_NAME)"
  fi

  echo
  echo "progress"
  run_reader "$R_MACHINE" "$R_DIR" "$R_METHOD"
}

reader_path() {
  # Method column awm-hps -> progress/awm.py; with no matching script, the generic one
  local base="${1%%-*}"     # awm-hps -> awm
  local reader="$SELF_DIR/progress/$base.py"
  [ -f "$reader" ] || reader="$SELF_DIR/progress/generic.py"
  echo "$reader"
}

run_reader() {
  local machine="$1" dir="$2" method="$3"
  local reader; reader="$(reader_path "$method")"

  if [ "$machine" = "local" ]; then
    show_cmd "$REMOTE_PYTHON $reader '$dir'"
    "$REMOTE_PYTHON" "$reader" "$dir"
  else
    # The reader is piped over from here, so the remote side needs nothing installed
    show_cmd "ssh $machine \"$REMOTE_PYTHON - '$dir'\" < $reader"
    # shellcheck disable=SC2086
    ssh $SSH_OPTS "$machine" "$REMOTE_PYTHON - '$dir'" < "$reader"
  fi
}

dump_series_json() {
  # dump_series_json <machine> <dir> <reader>: raw series as JSON on stdout, for exp report
  local machine="$1" dir="$2" reader="$3"
  if [ "$machine" = "local" ]; then
    show_cmd "$REMOTE_PYTHON $reader '$dir' --json"
    "$REMOTE_PYTHON" "$reader" "$dir" --json
  else
    show_cmd "ssh $machine \"$REMOTE_PYTHON - '$dir' --json\" < $reader"
    # shellcheck disable=SC2086
    ssh $SSH_OPTS "$machine" "$REMOTE_PYTHON - '$dir' --json" < "$reader"
  fi
}

cmd_log() {
  local name="${1:-$(first_run_name)}"
  load_run "$name" || return 1
  local log
  log="$(newest_log "$R_MACHINE" "$R_DIR")"
  if [ -z "$log" ]; then
    echo "no log found in $R_DIR/$LOG_DIR." >&2
    return 1
  fi
  echo "following $log (Ctrl+C to exit; the training keeps running)" >&2
  run_on "$R_MACHINE" "tail -f '$log'"
}

cmd_errors() {
  local name="${1:-$(first_run_name)}"
  load_run "$name" || return 1
  run_on "$R_MACHINE" "grep -rn -E 'Traceback|Error|error:|FAILED|nan|out of memory' '$R_DIR/$LOG_DIR' 2>/dev/null | tail -40"
}

cmd_attach() {
  local name="${1:-$(first_run_name)}"
  load_run "$name" || return 1
  if [ "$R_TMUX" = "-" ]; then
    echo "the tmux column for $R_NAME is -, so there is no session to attach to." >&2
    return 1
  fi
  if [ "$R_MACHINE" = "local" ]; then
    show_cmd "tmux attach -t '$R_TMUX'"
    tmux attach -t "$R_TMUX"
  else
    show_cmd "ssh -t $R_MACHINE tmux attach -t '$R_TMUX'"
    # shellcheck disable=SC2086
    ssh -t $SSH_OPTS "$R_MACHINE" "tmux attach -t '$R_TMUX'"
  fi
}

cmd_config() {
  local name="${1:-$(first_run_name)}"
  load_run "$name" || return 1
  run_on "$R_MACHINE" "cat '$R_DIR/launch.sh'"
}

cmd_plan() {
  local name="${1:-$(first_run_name)}"
  load_run "$name" || return 1
  local path="$R_DIR/$PLAN_FILE"

  if run_on "$R_MACHINE" "[ -f '$path' ]" >/dev/null 2>&1; then
    run_on "$R_MACHINE" "cat '$path'"
    return 0
  fi

  # Nothing there, so generate the template. The six items come from
  # references/experiment-design.md; the criterion is the one most often skipped,
  # so the template says so outright.
  run_on "$R_MACHINE" "cat > '$path'" <<'PLAN'
# Pre-registration - write it before the run, check against it after

Hypothesis: I think <the change> will improve <the metric>, because <the reason>
Control: the baseline is <what>, at the same budget, same data, same evaluation
Variable: this run changes only <one thing>
Criterion: judge by <metric>; it counts only if it moves past <how much> (decide now, not after seeing the result)
Budget and stop-loss: run for at most <how long>; stop early if <what happens>
Prediction: I expect <what>, confidence <high/medium/low>
PLAN
  echo
  echo "Wrote $path - fill in the <angle brackets>."
  echo "Once it's filled in, exp status $name will print the criterion next to the metrics."
}

cmd_report() {
  local name="" out=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --out)     out="${2:-}"; shift 2 ;;
      --out=*)   out="${1#--out=}"; shift ;;
      -h|--help) echo "usage: exp report [name] [--out path]" >&2; return 0 ;;
      -*)        echo "unknown option: $1" >&2; return 1 ;;
      *)         name="$1"; shift ;;
    esac
  done
  [ -n "$name" ] || name="$(first_run_name)"
  load_run "$name" || return 1

  # The report goes to the current directory, not the run directory - that may be
  # shared, read-only, or someone else's. Change the path with REPORT_DIR, or
  # override for one call with --out.
  local target="${out:-${REPORT_DIR:-.}/exp-report-$R_NAME.html}"
  local target_dir; target_dir="$(dirname "$target")"
  if [ ! -d "$target_dir" ]; then
    mkdir -p "$target_dir" || { echo "cannot create output dir: $target_dir" >&2; return 1; }
  fi

  printf 'run: %s\n' "$R_NAME"
  printf 'machine: %s\n' "$R_MACHINE"
  printf 'dir: %s\n' "$R_DIR"
  printf 'method: %s\n' "$R_METHOD"
  echo

  local tmp; tmp="$(mktemp -d)"

  # 1) raw metric series (JSON). Falls back to the generic reader when a
  #    method-specific reader doesn't support --json.
  local reader; reader="$(reader_path "$R_METHOD")"
  dump_series_json "$R_MACHINE" "$R_DIR" "$reader" > "$tmp/series.json"
  if [ "$(head -c 1 "$tmp/series.json" 2>/dev/null)" != "{" ]; then
    reader="$SELF_DIR/progress/generic.py"
    dump_series_json "$R_MACHINE" "$R_DIR" "$reader" > "$tmp/series.json"
  fi

  # 2) the full pre-registration (criterion and prediction come out of it)
  run_on "$R_MACHINE" "cat '$R_DIR/$PLAN_FILE'" > "$tmp/plan.md"

  # 3) health checks (same logic as exp status)
  health_lines tsv > "$tmp/health.tsv"

  # 4) render to a self-contained HTML file locally (the renderer reads and writes
  #    local files)
  local py="${LOCAL_PYTHON:-$REMOTE_PYTHON}"
  local renderer="$SELF_DIR/progress/report.py"
  show_cmd "$py $renderer --out '$target' --name '$R_NAME' --machine '$R_MACHINE' --dir '$R_DIR' --method '$R_METHOD' --series-json $tmp/series.json --plan $tmp/plan.md --health $tmp/health.tsv"
  if ! "$py" "$renderer" \
        --out "$target" \
        --name "$R_NAME" --machine "$R_MACHINE" --dir "$R_DIR" --method "$R_METHOD" \
        --series-json "$tmp/series.json" --plan "$tmp/plan.md" --health "$tmp/health.tsv"; then
    rm -rf "$tmp"
    echo "render failed." >&2
    return 1
  fi
  rm -rf "$tmp"

  echo
  echo "report written: $target"
  echo "Single self-contained file - double-click to open it in a browser, offline."
}

confirm() {
  printf '%s [y/N] ' "$1"
  local answer
  read -r answer
  case "$answer" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

cmd_start() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    echo "usage: exp start <name>" >&2
    return 1
  fi
  load_run "$name" || return 1
  if [ "$R_TMUX" = "-" ]; then
    echo "the tmux column for $R_NAME is -, meaning exp start/stop doesn't manage it." >&2
    echo "to start it yourself: tmux new -d -s <name> 'bash launch.sh'" >&2
    return 1
  fi

  echo "GPUs on $R_MACHINE before we start:"
  cmd_gpu "$R_MACHINE"
  echo
  if ! confirm "Start $R_NAME on $R_MACHINE (tmux: $R_TMUX)?"; then
    echo "cancelled."
    return 0
  fi

  run_on "$R_MACHINE" "cd '$R_DIR' && tmux new -d -s '$R_TMUX' 'bash launch.sh'"
  echo "started. After a minute or two, run exp log $R_NAME to confirm the model loaded."
  echo "tip: on a first run, set the step count to 2 and get it running end to end, then set the real number."
}

cmd_stop() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    echo "usage: exp stop <name>" >&2
    return 1
  fi
  load_run "$name" || return 1
  if [ "$R_TMUX" = "-" ]; then
    echo "the tmux column for $R_NAME is -, so exp stop doesn't manage it." >&2
    return 1
  fi

  if ! confirm "Stop $R_NAME (tmux: $R_TMUX, on $R_MACHINE)?"; then
    echo "cancelled."
    return 0
  fi

  run_on "$R_MACHINE" "tmux kill-session -t '$R_TMUX'"
  echo "stopped. To resume, run exp start $R_NAME."
}

usage() {
  cat <<EOF
exp - one entry point for training runs

  exp list                which runs are registered, and which are still going
  exp status [name]       progress, metric trend, health checks (defaults to the first registry row)
  exp log [name]          follow the log live (Ctrl+C to exit; the training keeps running)
  exp errors [name]       search for errors
  exp gpu <machine>       see whether a machine's GPUs are free
  exp start <name>        start it (shows you the GPUs and asks before launching)
  exp stop <name>         stop it
  exp attach [name]       attach to the tmux session (exit with Ctrl+B then D)
  exp config [name]       print this run's launch.sh
  exp plan [name]         pre-registration: generates the template if absent, prints it if present
  exp report [name]       render a self-contained HTML report (curves + criterion line + health checks)
                          writes to ./exp-report-<name>.html; change with --out or REPORT_DIR
  exp help                this text

Every command prints the command it actually runs first (the grey + ...), so you
can copy it, modify it, and use it directly. Once you're comfortable you don't
need this tool at all.

config:   $EXPT_CONF
registry: $RUNS_CONF
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  list|ls)          cmd_list "$@" ;;
  status|st)        cmd_status "$@" ;;
  log|logs)         cmd_log "$@" ;;
  errors|err)       cmd_errors "$@" ;;
  gpu)              cmd_gpu "$@" ;;
  start)            cmd_start "$@" ;;
  stop)             cmd_stop "$@" ;;
  attach|at)        cmd_attach "$@" ;;
  config|conf)      cmd_config "$@" ;;
  plan|pl)          cmd_plan "$@" ;;
  report|rep)       cmd_report "$@" ;;
  help|-h|--help)   usage ;;
  *)
    echo "unknown command: $cmd" >&2
    echo
    usage
    exit 1
    ;;
esac
