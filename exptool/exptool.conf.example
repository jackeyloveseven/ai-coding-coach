# exptool config template.
#
# Usage: copy it to ~/.config/exptool/config and edit it for your environment.
#   mkdir -p ~/.config/exptool
#   cp exptool.conf.example ~/.config/exptool/config
#
# This is a shell fragment, sourced directly by exp. So use NAME=value, with no
# spaces around the =.

# Where the runs registry lives
RUNS_CONF="$HOME/.config/exptool/runs.conf"

# ssh options. BatchMode=yes stops ssh from hanging on a password prompt and makes
# it fail outright. If you log in with a password, drop the BatchMode entry.
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=5"

# The interpreter used to run the progress reader on the remote side. The reader is
# piped over from here, so the remote host doesn't need this repository installed.
REMOTE_PYTHON="python3"

# The interpreter exp report uses to render HTML locally. Empty falls back to
# REMOTE_PYTHON (in local mode the two are the same thing anyway).
LOCAL_PYTHON=""

# Where exp report writes by default (relative to the current directory). The
# default is the current directory - keep it out of the run directory, which may
# be shared, read-only, or someone else's.
REPORT_DIR="."

# Names of the failure / completion marker files. exp status looks for these two in
# the run directory.
FAILED_MARKER="FAILED"
DONE_MARKER="DONE"

# Log directory (relative to the run directory)
LOG_DIR="logs"

# Health-check address for the reward service (optional). Empty skips the check.
# Put in your own address - don't copy one out of someone else's notes.
# Criterion: HTTP 200 or 401 both mean it's up (401 just means no credentials were
# sent); 000 means no response.
REWARD_HEALTH_URL=""
